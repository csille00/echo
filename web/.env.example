# authentik (production): same origin as API behind Caddy forward-auth
VITE_AUTH_MODE=authentik
# Leave empty to use Vite proxy to localhost:8000
VITE_API_URL=
# Optional: Authentik end-session URL for Sign out
# VITE_AUTHENTIK_LOGOUT_URL=https://auth.ellisfam.space/if/flow/default-invalidation-flow/

# Local dev without SSO:
# VITE_AUTH_MODE=dev
# VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Legacy Supabase password login (not used with Authentik):
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=http://192.168.1.54:54323
# VITE_SUPABASE_ANON_KEY=your-anon-key
