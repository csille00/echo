# The UI asks the API which auth mode to use (GET /api/v1/auth/config).
# Leave empty to send /api through the Vite dev proxy.
VITE_API_URL=

# Fallback only, when that config request fails.
# Production builds behind Authentik set VITE_AUTH_MODE=authentik.
# VITE_AUTH_MODE=authentik
# VITE_AUTHENTIK_LOGOUT_URL=https://auth.example.com/if/flow/default-invalidation-flow/

# Header auth for development without accounts:
# VITE_AUTH_MODE=dev
# VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Legacy Supabase password login:
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your-anon-key
