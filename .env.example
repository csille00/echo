# Self-hosted stack defaults. Google Cloud Vision is the only external cloud service.

# PostgreSQL (app data + DBOS system DB derived from this URL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/journal_search

# Backends — mix and match independently (database stays plain PostgreSQL)
STORAGE_BACKEND=local
AUTH_BACKEND=dev_header
REALTIME_BACKEND=none

# Object storage (when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=data/uploads

# Supabase (only when a *_BACKEND=supabase setting is enabled)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=...
# SUPABASE_STORAGE_BUCKET=journal-pages

# OCR — google_vision is the only external service; tesseract/surya run fully on-prem
OCR_PROVIDER=google_vision
# GOOGLE_VISION_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Embeddings — google (default, API) or ollama (self-hosted GPU)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
# GOOGLE_EMBEDDING_API_KEY=...          # optional; reuses GOOGLE_VISION_API_KEY if unset
# GOOGLE_EMBEDDING_CREDENTIALS_FILE=... # optional; reuses GOOGLE_APPLICATION_CREDENTIALS
# OLLAMA_BASE_URL=http://localhost:11434  # when EMBEDDING_PROVIDER=ollama

# LLM text cleanup (optional; off by default — needs Ollama if enabled)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_CLEANUP_ENABLED=false

# Self-hosted DBOS Conductor (optional ops UI; omit to run DBOS without Conductor)
# DBOS_CONDUCTOR_URL=ws://localhost:8090/
# DBOS_CONDUCTOR_KEY=

# App
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
