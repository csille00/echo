# Self-hosted defaults. Copy to .env and change what you need.
# The API listens on localhost until you put a reverse proxy in front of it.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/journal_search

# Bind address. Use 0.0.0.0 only inside a container or behind a proxy you control.
API_HOST=127.0.0.1
LISTEN_PORT=8000
# Directory of the built web UI (npm run build). Empty leaves the API as JSON only.
# WEB_ROOT=web/dist

# Backends — mix and match independently (database stays plain PostgreSQL)
STORAGE_BACKEND=local
AUTH_BACKEND=local
# AUTH_BACKEND=dev_header
# AUTH_BACKEND=authentik
# AUTHENTIK_FORWARD_AUTH=true
# AUTHENTIK_UID_HEADER=X-Authentik-Uid
#
# SSO via any OpenID Connect provider (Authentik, Authelia, Keycloak, Kanidm, ...).
# Register the redirect URL {PUBLIC_URL}/api/v1/auth/oidc/callback on the client.
# OIDC_ISSUER=https://auth.example.com/application/o/journal/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=SSO
# PUBLIC_URL=https://journal.example.com
# OIDC_AUTO_REGISTER=true
# SESSION_COOKIE_SECURE=true
REALTIME_BACKEND=none

# Object storage (when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=data/uploads

# Supabase (only when a *_BACKEND=supabase setting is enabled)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=...
# SUPABASE_STORAGE_BUCKET=journal-pages

# OCR — tesseract runs on this machine; google_vision and surya are optional
OCR_PROVIDER=tesseract
# OCR_PROVIDER=google_vision
# GOOGLE_VISION_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Embeddings — ollama (default) or google
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=google
# GOOGLE_EMBEDDING_API_KEY=...

# LLM text cleanup (optional; off by default — needs Ollama if enabled)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_CLEANUP_ENABLED=false

# Self-hosted DBOS Conductor (optional ops UI; omit to run DBOS without Conductor)
# DBOS_CONDUCTOR_URL=ws://localhost:8090/
# DBOS_CONDUCTOR_KEY=

# App
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
