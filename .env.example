# Database (Supabase connection string)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/journal_search

# DBOS Database config (parsed from DATABASE_URL or set individually)
DBOS_DATABASE_HOST=localhost
DBOS_DATABASE_PORT=5432
DBOS_DATABASE_USER=postgres
DBOS_DATABASE_PASSWORD=password
DBOS_DATABASE_NAME=journal_search

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=journal-pages

# OCR Configuration
OCR_PROVIDER=tesseract  # tesseract, surya, google_vision

# Google Cloud Vision (if using) — use one of:
# GOOGLE_VISION_API_KEY=AIzaSy...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Embedding Configuration
EMBEDDING_PROVIDER=ollama  # ollama, openai
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Ollama (if using)
OLLAMA_BASE_URL=http://localhost:11434

# LLM text cleanup (optional, uses Vercel AI SDK)
# pip install journal-search[llm-cleanup]
LLM_PROVIDER=ollama  # ollama, openai
LLM_MODEL=llama3.2

# OpenAI (if using)
# OPENAI_API_KEY=sk-...

# App settings
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
