# Production example — API on same host as supabase-journal-search stack.
# Copy to .env and fill secrets from Studio → Settings → API.

API_PORT=8000

# Postgres (internal Docker DNS — not Kong)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@supabase-journal-search-db:5432/postgres

# Supabase backends
STORAGE_BACKEND=supabase
AUTH_BACKEND=supabase
REALTIME_BACKEND=supabase

SUPABASE_URL=http://supabase-journal-search-kong:8000
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=journal-pages

# OCR + embeddings (Google Cloud — no local GPU required)
OCR_PROVIDER=google_vision
GOOGLE_CREDENTIALS_HOST_PATH=/home/you/secrets/google-vision.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vision.json

EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# LLM cleanup off by default (would need Ollama or another LLM backend)
LLM_CLEANUP_ENABLED=false

# DBOS Conductor (start docker-compose.dbos.yml first, register app in Console)
DBOS_CONDUCTOR_URL=ws://dbos-conductor:8090/
DBOS_CONDUCTOR_KEY=your-app-api-key-from-dbos-console

DEBUG=false
ALLOWED_ORIGINS=["https://your-frontend.example"]
