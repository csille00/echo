# DBOS Conductor stack — copy to .env.dbos
# Get a trial license key: https://console.dbos.dev

DBOS_CONDUCTOR_LICENSE_KEY=your-trial-license-key-here

# Conductor metadata Postgres (not your app database)
DBOS_PG_PASSWORD=dbos

# Console UI host port (http://127.0.0.1:18080)
DBOS_CONSOLE_PORT=18080
